# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# Data and training artifacts -- these live on Kaggle/Colab, never in git.
# Anchored with a leading slash so they match only at the repo root and do
# NOT swallow src/data/.
/faces/
/data/
/runs/
/tiny_faces/

# Per-run result JSONs are regenerated output, but RESULTS.md is the hand-kept
# record of every number and must be tracked. Negation needs the glob form:
# a bare "/results/" excludes the directory itself and "!" cannot re-include
# anything inside an excluded directory.
/results/*
!/results/RESULTS.md
*.pt
*.tar
*.zip
*.mp4
/splits.json
/manifest.csv

# Papers (keep the repo lean; they are not ours to redistribute)
*.pdf

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated report artifacts (rebuild with report/build_pdf.py)
/report/*.html
/report/*.pdf
